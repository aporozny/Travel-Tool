{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "env": {
    "ENABLE_STOP_REVIEW": "0"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; command -v typescript-language-server >/dev/null 2>&1 && exit 0; npm install -g --no-fund --no-audit typescript-language-server@6.0.2 typescript@5.9.3 >/dev/null 2>&1 || echo \"typescript-language-server install failed; TypeScript LSP unavailable this session\" >&2",
            "timeout": 120,
            "statusMessage": "Installing TypeScript language server..."
          }
        ]
      }
    ]
  }
}
